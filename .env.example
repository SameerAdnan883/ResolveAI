# ResolveAI Environment Configuration Example

# Active LLM Provider (Local Ollama, Zero-Cost Inference)
LLM_PROVIDER=qwen

# Local Qwen3.5:4B via Ollama
QWEN_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434
QWEN_LOW_REASONING=true

# Security & Authentication (Change in Production!)
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///./resolveai.db
CHECKPOINT_DATABASE_URL=./resolveai_checkpoints.db

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Application Settings
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_PORT=8501

# Business Rules Limits
AUTO_REFUND_MAX_AMOUNT=0.00
HIGH_VALUE_THRESHOLD=150.00
MAX_AGENT_RETRIES=2
